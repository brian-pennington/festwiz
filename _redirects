# FestWiz mode switch — see HALLOWEEN-PLAN.md
#
# Rules are tried in order, first match wins.
#
#   1. bare app paths get their trailing slash, or the wildcard below would
#      rewrite /halloween into /halloween/halloween and 404
#   2. each app is served at its own path, in either mode
#   3. one wildcard decides what "/" serves — that line IS the mode switch

/halloween            /halloween/               301
/southbysouthwest     /southbysouthwest/        301

/southbysouthwest/*   /southbysouthwest/:splat  200
/halloween/*          /halloween/:splat         200

# Legacy root asset paths. A browser still holding the pre-move festival HTML
# at "/" asks for these relatively; without these rules the wildcard below
# hands it Halloween's stylesheet, which renders that old markup as an
# illegible page with a stuck-open dialog. Point them at the app they belong
# to so a stale page stays coherent until its service worker updates.
/style.css            /southbysouthwest/style.css            200
/app.js               /southbysouthwest/app.js               200
/schedule.js          /southbysouthwest/schedule.js          200
/schedule.html        /southbysouthwest/schedule.html        200
/artists.json         /southbysouthwest/artists.json         200
/shows.json           /southbysouthwest/shows.json           200
/unofficial_shows.json    /southbysouthwest/unofficial_shows.json    200
/unofficial_artists.json  /southbysouthwest/unofficial_artists.json  200
/recommended.json     /southbysouthwest/recommended.json     200
/venues.json          /southbysouthwest/venues.json          200
/venue_coords.json    /southbysouthwest/venue_coords.json    200
/announcements.json   /southbysouthwest/announcements.json   200

# ── HALLOWEEN MODE (active) ───────────────────────────────────────────────
/*                    /halloween/:splat         200

# ── FESTIVAL MODE ─────────────────────────────────────────────────────────
# After Halloween: comment the line above, uncomment this one, and move the
# service-worker root scope back (see _headers).
# /*                  /southbysouthwest/:splat  200
